                                <TextBlock Text="Orbital Pixel Shift" Foreground="{StaticResource BrushTextPrimary}" FontSize="11" />
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="AUDIO &amp; ALERTS" Foreground="{StaticResource BrushCyan}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6" />
                    <Border Background="#0E131E" CornerRadius="8" Padding="12" Margin="0,0,0,18" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding Settings.EnableVolumeOverlay}" Style="{StaticResource TacticalToggleSwitch}" Margin="0,0,0,8">
                                <TextBlock Text="Volume wheel pop-up" Foreground="{StaticResource BrushTextPrimary}" FontSize="11" />
                            </CheckBox>
                            <CheckBox IsChecked="{Binding Settings.EnableGpuDeltaAlert}" Style="{StaticResource TacticalToggleSwitch}" Margin="0,0,0,8">
                                <TextBlock Text="GPU thermal paste alert" Foreground="{StaticResource BrushTextPrimary}" FontSize="11" />
                            </CheckBox>
                            <CheckBox IsChecked="{Binding Settings.EnableMicMonitor}" Style="{StaticResource TacticalToggleSwitch}">
                                <TextBlock Text="Monitor microphone" Foreground="{StaticResource BrushTextPrimary}" FontSize="11" />
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <Button Command="{Binding SaveSettingsCommand}" Style="{StaticResource AmberActionButton}" Content="💾 SAVE SETTINGS" HorizontalAlignment="Stretch" Height="36" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════════════ -->
        <!-- ROW 2: FOOTER BAR (Linear Stealth Status Line)                        -->
        <!-- ══════════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Padding="14,8" Background="{StaticResource BrushSurface}" CornerRadius="8" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#0A1C2C" BorderBrush="{StaticResource BrushCyan}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource BrushCyan}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Burn-In Guard: " Foreground="{StaticResource BrushCyan}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Text="{Binding BurnInStatus}" Foreground="{StaticResource BrushTextPrimary}" FontSize="10" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource BrushTextPrimary}" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="Zero External Apps · Embedded LibreHardwareMonitorLib + Direct HID" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <!-- CONCEPT 1: ASUS ROG STRIX EDITION / ARMOURY CRATE v6 DESIGN SYSTEM     -->
    <!-- ══════════════════════════════════════════════════════════════════════ -->

    <!-- Color Tokens: ASUS ROG Strix Matte Obsidian, Crimson & Strix Cyan -->
    <Color x:Key="ColorVoid">#080A0F</Color>
    <Color x:Key="ColorSurface">#0D111A</Color>
    <Color x:Key="ColorCard">#101520</Color>
    <Color x:Key="ColorCardBorder">#1F293D</Color>
    <Color x:Key="ColorCardBorderHover">#FF003C</Color>
    <Color x:Key="ColorCyan">#00E5FF</Color>
    <Color x:Key="ColorCyanHover">#5CFFFF</Color>
    <Color x:Key="ColorCyanDark">#092436</Color>
    <Color x:Key="ColorAmber">#FF003C</Color> <!-- ROG Signature Crimson Accent -->
    <Color x:Key="ColorAmberActual">#FF003C</Color> <!-- ROG Crimson for power & alert telemetry -->
    <Color x:Key="ColorAmberHover">#FF2E5D</Color>
    <Color x:Key="ColorSuccess">#10B981</Color>
    <Color x:Key="ColorTextPrimary">#F8FAFC</Color>
    <Color x:Key="ColorTextSecondary">#8A9BB2</Color>
    <Color x:Key="ColorTextMuted">#4A5A70</Color>
    <Color x:Key="ColorRogDarkRed">#26070E</Color>

    <SolidColorBrush x:Key="BrushVoid" Color="{StaticResource ColorVoid}" />
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="BrushCard" Color="{StaticResource ColorCard}" />
    <SolidColorBrush x:Key="BrushCardBorder" Color="{StaticResource ColorCardBorder}" />
    <SolidColorBrush x:Key="BrushCardBorderHover" Color="{StaticResource ColorCardBorderHover}" />
    <SolidColorBrush x:Key="BrushCyan" Color="{StaticResource ColorCyan}" />
    <SolidColorBrush x:Key="BrushCyanHover" Color="{StaticResource ColorCyanHover}" />
    <SolidColorBrush x:Key="BrushCyanDark" Color="{StaticResource ColorCyanDark}" />
    <SolidColorBrush x:Key="BrushAmber" Color="{StaticResource ColorAmber}" />
    <SolidColorBrush x:Key="BrushAmberActual" Color="{StaticResource ColorAmberActual}" />
    <SolidColorBrush x:Key="BrushAmberHover" Color="{StaticResource ColorAmberHover}" />
    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />
    <SolidColorBrush x:Key="BrushRogDarkRed" Color="{StaticResource ColorRogDarkRed}" />
    <DrawingBrush x:Key="EditorGridBrush" TileMode="Tile" Viewport="0,0,12,12" ViewportUnits="Absolute" Viewbox="0,0,2,2" ViewboxUnits="Absolute" Opacity="0.22">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="{x:Null}" Geometry="M 0,0 L 0,2 M 0,0 L 2,0">
                <GeometryDrawing.Pen>
                    <Pen Brush="#FF003C" Thickness="1" />
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <FontFamily x:Key="RogDisplayFont">Bahnschrift SemiBold</FontFamily>
    <FontFamily x:Key="RogBodyFont">Segoe UI</FontFamily>

    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <!-- VECTOR STREAM GEOMETRY ICONS (High-DPI Razor Sharp SVG Paths)          -->
    <!-- ══════════════════════════════════════════════════════════════════════ -->
